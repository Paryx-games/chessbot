{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chessbot",
  "version": "1.1.0",
  "identifier": "com.chess-stockfish.board-editor",
  "build": {
    "frontendDist": "../frontend",
    "beforeDevCommand": "node scripts/sync-sounds.cjs",
    "beforeBuildCommand": "node scripts/sync-sounds.cjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Chessbot",
        "width": 1310,
        "height": 925,
        "minWidth": 1310,
        "minHeight": 925,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/stockfish"
    ],
    "resources": {
      "licenses/": "licenses/",
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "icon": [
      "icons/icon.ico"
    ]
  }
}
